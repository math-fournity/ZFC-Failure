# The top-level repo is the integrated workspace. The two existing nested repos
# remain physical source islands and are represented by snapshots/provenance.
AI对话录/
workspace/

# Host/runtime and operating-system artifacts.
.DS_Store
__pycache__/
*.py[cod]
*.agdai

# Private raw trajectory/context material. Public visible evidence belongs under
# sources/ and audit/ with explicit provenance; do not commit hidden reasoning.
private-audit/
sources/private-trajectory/
*.secret
*.pem

# Temporary generated output and local virtual environments.
.venv/
venv/
tmp/
*.tmp
*.partial

# CG-007 incremental Lean build cache (devbuild.py / lean_probe.py).
# Reproducible from the pinned toolchain; never part of a receipt.
.cg007-build/

# CG-007 dev build cache actually produced by devbuild_ns.py (toolchain-pinned,
# reproducible, not a receipt source). Mirrors .cg007-build/; the legacy /tmp path
# is not written back. Never commit .olean/.ilean/_state.json from this tree.
.claude/goals/CG-007-formalization-completion/tools/devbuild_ns/

# CG-007 independent-reproduction build output (verify/repro-build). Reproducible from the
# pinned toolchain via verify/driver_repro.py; never part of a receipt. The receipt and the
# driver ARE committed; the oleans/logs are not.
.claude/goals/CG-007-formalization-completion/verify/repro-build/

# Generated export boxes are kept outside the Git tree unless explicitly
# accepted as a source artifact.
exchange/outbox/*.zip
exchange/outbox/*.receipt.json

# Raw Codex trajectory/context exports captured as private audit evidence for
# Atria's working directory. Same class as private-audit/; public evidence belongs
# under sources/ and audit/ with explicit provenance.
Atria的工作目录/.evidence/

# CodeArts IDE local workspace settings (e.g. .arts/settings.json claw-mode
# flag). Machine-local tool state; never part of the research tree.
.arts/

# Per-page rasterised images and other intermediates of the visual-audit pipeline
# (docs/罗素解决考古/**/_visualcheck/, _audit-binary/, _split/, _upload/, mineru_md/
# sub-dirs).  These are process artifacts: the sentence that an audit actually relies
# on lives as text in the Z*/01–04 evidence files with a page locator, so committing
# hundreds of multi-MB PNGs adds no evidential value and makes the tree look dirty for
# weeks afterwards.  The already-tracked files (zermelo 1908, the 21 pages fully audited
# for Z01/Q1, committed in 18c0227cd) STAY tracked — this rule does not untrack them,
# and gitignore cannot change tracked files' content anyway.
docs/罗素解决考古/**/_visualcheck/
docs/罗素解决考古/**/_audit-binary/
docs/罗素解决考古/**/_split/
docs/罗素解决考古/**/_upload/
