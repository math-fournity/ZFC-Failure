#lang rzk-1

-- Negative control MP-CG001-JUDGES-GATHERINGS-RZK-NEG-001 (CG001-C-457), checked after
-- ../two-causes-rzk/TwoCausesUnderUnivalence.rzk and JudgesAndGatheringsRzk.rzk in the same run.
--
-- Claim to be refused: the gathering of the 1-types stops like the gathering of sets, at stage 2,
-- so fuel 1 already returns 2.  With the concrete judge the kernel runs the program itself.
-- Expected: rejected, because stage 2 says no (the gathering of the 1-types is not a 1-type) and the
-- run computes to nothing; it answers only at stage 3 (C-79 (b)).

#define wrong-gathering-stops-early
  ( univ : Univalence)
  ( W : BoundedHeights)
  : run (Gathering (succ (succ zero))) (judge-gathering univ W zero) (succ zero) (succ zero)
      = just ℕ (succ (succ zero))
  := refl
